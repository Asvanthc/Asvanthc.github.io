---
import { principles } from '../data/principles';
---

<ol class="principles">
  {
    principles.map((p, i) => (
      <li class="principle" data-reveal data-reveal-delay={(i % 2) * 50}>
        <span class="p-n" aria-hidden="true">{p.n}</span>
        <div class="p-body">
          <h3 class="p-title">{p.title}</h3>
          <p class="p-text">{p.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .principles {
    list-style: none;
    display: grid;
    gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
  }

  .principle {
    display: flex;
    gap: 1rem;
    padding: 1.35rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--dur) var(--ease);
  }

  .principle:hover { background: var(--surface-2); }

  /* Vertical rule between the two columns on wide screens. */
  @media (min-width: 860px) {
    .principle:nth-child(odd) { border-right: 1px solid var(--border); }
    .principle:nth-last-child(-n + 2) { border-bottom: 0; }
  }

  @media (max-width: 859px) {
    .principle:last-child { border-bottom: 0; }
  }

  .p-n {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    flex: none;
    padding-top: 0.15rem;
    opacity: 0.8;
  }

  .p-title {
    font-size: var(--step-0);
    letter-spacing: -0.014em;
    line-height: 1.35;
  }

  .p-text {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 58ch;
  }
</style>
