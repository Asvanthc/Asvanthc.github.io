---
import { skillGroups, levels } from '../data/skills';
---

<div class="skills">
  <div class="legend" role="note">
    {
      (['production', 'working', 'learning'] as const).map((l) => (
        <div class={`legend-row lvl-${l}`}>
          <span class="legend-key">
            <span class="dot" aria-hidden="true" />
            {levels[l].label}
          </span>
          <span class="legend-blurb">{levels[l].blurb}</span>
        </div>
      ))
    }
  </div>

  <div class="groups">
    {
      skillGroups.map((g, i) => (
        <section class="group" data-reveal data-reveal-delay={i * 40}>
          <header class="group-head">
            <h3 class="group-title">{g.title}</h3>
            {g.note && <p class="group-note">{g.note}</p>}
          </header>
          <ul class="items">
            {g.items.map((item) => (
              <li class={`item lvl-${item.level}`}>
                <span class="dot" aria-hidden="true" />
                <span class="item-name">{item.name}</span>
                <span class="visually-hidden"> — {levels[item.level].label}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* --- Legend --- */
  .legend {
    display: grid;
    gap: 0.6rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  .legend-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .legend-key {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step--1);
    font-weight: 560;
    color: var(--text);
  }

  .legend-blurb {
    font-size: var(--step--2);
    color: var(--text-muted);
    line-height: 1.5;
    padding-left: 1.05rem;
  }

  /* --- Level encoding: colour AND fill, so it does not rely on hue alone --- */
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    flex: none;
    border: 1.5px solid var(--lvl-color);
    background: var(--lvl-fill);
  }

  .lvl-production { --lvl-color: var(--signal); --lvl-fill: var(--signal); }
  .lvl-working { --lvl-color: var(--accent); --lvl-fill: transparent; }
  .lvl-learning { --lvl-color: var(--text-faint); --lvl-fill: transparent; }
  .lvl-learning .dot { border-style: dashed; }

  /* --- Groups --- */
  .groups {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  .group {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
  }

  .group-head {
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.9rem;
  }

  .group-title {
    font-size: var(--step-0);
    letter-spacing: -0.012em;
  }

  .group-note {
    font-size: var(--step--2);
    color: var(--text-faint);
    margin-top: 0.3rem;
    line-height: 1.5;
  }

  .items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .item.lvl-production .item-name { color: var(--text); }
</style>
