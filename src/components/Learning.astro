---
import { learning } from '../data/skills';
---

<div class="learning">
  {
    learning.map((l, i) => (
      <article class="card" data-reveal data-reveal-delay={i * 60}>
        <header class="card-head">
          <h3 class="card-title">{l.title}</h3>
          <span class="card-badge">In progress</span>
        </header>
        <p class="card-body">{l.body}</p>
        <ul class="card-items">
          {l.items.map((item) => (
            <li class="tag">{item}</li>
          ))}
        </ul>
      </article>
    ))
  }
</div>

<style>
  .learning {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  /* A progress hint that is explicitly not a percentage — it has no end point. */
  .card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent 70%);
    opacity: 0.5;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.7rem;
  }

  .card-title {
    font-size: var(--step-1);
    letter-spacing: -0.018em;
  }

  .card-badge {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-faint);
    white-space: nowrap;
    flex: none;
  }

  .card-body {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.65;
    flex: 1;
  }

  .card-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin-top: 1.1rem;
  }
</style>
