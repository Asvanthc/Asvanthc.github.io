---
import Icon from './Icon.astro';
import { readingTime, formatDate, isoDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** Compact rows for the homepage; full cards on the writing index. */
  compact?: boolean;
  /**
   * Heading level for post titles. The homepage nests this under a section h2,
   * so h3 is right there; the writing index sits directly under the page h1.
   */
  headingLevel?: 'h2' | 'h3';
}
const { posts, compact = false, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<ul class:list={['post-list', compact && 'is-compact']}>
  {
    posts.map((post, i) => (
      <li class="post-item" data-reveal data-reveal-delay={i * 45}>
        <a class="post-link" href={`/writing/${post.id}/`}>
          <div class="post-meta">
            <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
            <span class="dot" aria-hidden="true">·</span>
            <span>{readingTime(post)} min read</span>
          </div>

          <Heading class="post-title">{post.data.title}</Heading>
          {!compact && <p class="post-desc">{post.data.description}</p>}

          <div class="post-foot">
            <ul class="post-tags">
              {post.data.tags.slice(0, compact ? 2 : 4).map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
            <span class="post-go" aria-hidden="true">
              <Icon name="arrow" size={14} />
            </span>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .post-item { border-bottom: 1px solid var(--border); }

  .post-link {
    display: block;
    padding: 1.35rem 0.85rem 1.35rem 0.85rem;
    margin-inline: -0.85rem;
    border-radius: var(--radius);
    transition: background var(--dur) var(--ease);
  }

  .post-link:hover { background: var(--surface); }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .dot { opacity: 0.6; }

  .post-title {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    margin-top: 0.45rem;
    max-width: 44ch;
    transition: color var(--dur) var(--ease);
  }

  .post-link:hover .post-title { color: var(--accent); }

  .post-desc {
    color: var(--text-muted);
    font-size: var(--step--1);
    margin-top: 0.5rem;
    max-width: 66ch;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .post-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.85rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
  }

  .post-go {
    color: var(--text-faint);
    display: flex;
    flex: none;
    transition: color var(--dur) var(--ease), translate var(--dur) var(--ease);
  }

  .post-link:hover .post-go {
    color: var(--accent);
    translate: 3px 0;
  }

  .is-compact .post-link { padding-block: 1rem; }
  .is-compact .post-title { font-size: var(--step-0); }
</style>
