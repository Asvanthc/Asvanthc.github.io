---
import Icon from './Icon.astro';
import { site, socials } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true">
        <span class="px"></span><span class="px"></span><span class="px"></span><span class="px"></span>
      </span>
      <div>
        <p class="footer-name">{site.name}</p>
        <p class="footer-role">{site.role} at {site.company}</p>
      </div>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <div class="footer-col">
        <h2 class="footer-col-title">Site</h2>
        <a href="/#experience">Experience</a>
        <a href="/#engineering">Engineering</a>
        <a href="/writing">Writing</a>
        <a href="/#skills">Skills</a>
      </div>
      <div class="footer-col">
        <h2 class="footer-col-title">Elsewhere</h2>
        {
          socials.map((s) => (
            <a href={s.href} rel={s.icon === 'mail' ? undefined : 'me noopener'} target={s.icon === 'mail' ? undefined : '_blank'}>
              <Icon name={s.icon} size={13} /> {s.label}
            </a>
          ))
        }
        <a href="/rss.xml"><Icon name="rss" size={13} /> RSS</a>
      </div>
      <div class="footer-col">
        <h2 class="footer-col-title">More</h2>
        <a href={site.resume} download>Résumé (PDF)</a>
        <a href="/archive/">Archive</a>
        <a href="https://github.com/asvanthc/Asvanthc.github.io" target="_blank" rel="noopener">Source</a>
      </div>
    </nav>
  </div>

  <div class="wrap footer-bottom">
    <p>© {year} {site.name}</p>
    <p class="colophon">
      Built with Astro. Type set in Inter and JetBrains Mono. No analytics, no cookies, no
      tracking.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    margin-top: 0;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: space-between;
    padding-bottom: 2.5rem;
  }

  .footer-brand {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .brand-mark {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    width: 16px;
    height: 16px;
    flex: none;
    margin-top: 0.2rem;
  }

  .px { background: var(--accent); border-radius: 1.5px; }
  .px:nth-child(2) { opacity: 0.55; }
  .px:nth-child(3) { opacity: 0.35; }
  .px:nth-child(4) { background: var(--signal); }

  .footer-name {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .footer-role {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-faint);
    margin-top: 0.15rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col-title {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 400;
    margin-bottom: 0.1rem;
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease);
  }

  .footer-col a:hover { color: var(--accent); }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.1rem;
    border-top: 1px solid var(--border);
  }

  .footer-bottom p {
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .colophon { text-align: right; }

  @media (max-width: 560px) {
    .colophon { text-align: left; }
  }
</style>
