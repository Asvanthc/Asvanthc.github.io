---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lede?: string;
  /** Constrain the section body to reading width. */
  narrow?: boolean;
  class?: string;
  /** For sections whose heading lives inside the slotted content. */
  labelledby?: string;
}
const { id, eyebrow, title, lede, narrow = false, class: className, labelledby } = Astro.props;
const ariaLabelledBy = labelledby ?? (title && id ? `${id}-heading` : undefined);
---

<section class:list={['section', className]} id={id} aria-labelledby={ariaLabelledBy}>
  <div class:list={[narrow ? 'wrap-narrow' : 'wrap']}>
    {
      (eyebrow || title || lede) && (
        <header class="section-head" data-reveal>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && (
            <h2 class="section-title" id={id ? `${id}-heading` : undefined}>
              {title}
            </h2>
          )}
          {lede && <p class="section-lede">{lede}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section-head {
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }
</style>
