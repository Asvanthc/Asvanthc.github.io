---
import Icon from './Icon.astro';
import { education } from '../data/experience';
import { certifications, certificationPeriod, certificationPlatform } from '../data/certifications';

/** Group by issuer so 21 rows read as six sources rather than a wall. */
const byIssuer = certifications.reduce<Record<string, typeof certifications>>((acc, c) => {
  (acc[c.issuer] ||= []).push(c);
  return acc;
}, {});
const issuers = Object.entries(byIssuer).sort((a, b) => b[1].length - a[1].length);
---

<div class="credentials">
  <!-- Education: concise by design. It is not the headline. -->
  <section class="edu panel" data-reveal>
    <p class="eyebrow">Education</p>
    <h3 class="edu-degree">{education.degree}</h3>
    <p class="edu-school">
      {education.school} <span class="dim">· {education.location}</span>
    </p>
    <p class="edu-period">{education.period}</p>
    <ul class="edu-courses">
      {education.coursework.map((c) => <li class="tag">{c}</li>)}
    </ul>
  </section>

  <!-- Certifications: secondary, collapsed by default, no giant iframes. -->
  <section class="certs panel" data-reveal data-reveal-delay="80">
    <p class="eyebrow">Certifications</p>
    <h3 class="certs-title">
      {certifications.length} {certificationPlatform} course certificates
    </h3>
    <p class="certs-note">
      Coursework completed between {certificationPeriod}, before I started engineering
      professionally. Listed for completeness rather than as evidence of current expertise —
      the work section is the better signal.
    </p>

    <div class="issuers">
      {
        issuers.map(([issuer, items]) => (
          <details class="issuer">
            <summary class="issuer-summary">
              <span class="issuer-name">{issuer}</span>
              <span class="issuer-count">{items.length}</span>
              <span class="issuer-chevron" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="m3.5 5 2.5 2.5L8.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </summary>
            <ul class="cert-list">
              {items.map((c) => (
                <li class="cert">
                  <a class="cert-link" href={c.url} target="_blank" rel="noopener">
                    <span class="cert-name">{c.name}</span>
                    <Icon name="external" size={12} />
                  </a>
                  <code class="cert-id" title="Credential ID">{c.credentialId.slice(0, 12)}…</code>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </section>
</div>

<style>
  .credentials {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    align-items: start;
  }

  .panel { padding: 1.4rem; }

  .edu-degree {
    font-size: var(--step-1);
    letter-spacing: -0.018em;
  }

  .edu-school {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--text);
  }

  .dim { color: var(--text-faint); }

  .edu-period {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-muted);
    margin-top: 0.3rem;
  }

  .edu-courses {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin-top: 1.1rem;
  }

  .certs-title {
    font-size: var(--step-1);
    letter-spacing: -0.018em;
  }

  .certs-note {
    font-size: var(--step--1);
    color: var(--text-muted);
    margin-top: 0.5rem;
    line-height: 1.6;
  }

  .issuers {
    margin-top: 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .issuer { border-bottom: 1px solid var(--border); }
  .issuer:last-child { border-bottom: 0; }

  .issuer-summary {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.85rem;
    cursor: pointer;
    font-size: var(--step--1);
    list-style: none;
    transition: background var(--dur) var(--ease);
  }

  .issuer-summary::-webkit-details-marker { display: none; }
  .issuer-summary:hover { background: var(--surface-2); }

  .issuer-name { flex: 1; font-weight: 520; }

  .issuer-count {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-faint);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
  }

  .issuer-chevron {
    color: var(--text-faint);
    display: flex;
    transition: rotate var(--dur) var(--ease);
  }

  .issuer[open] .issuer-chevron { rotate: 180deg; }

  .cert-list {
    list-style: none;
    padding: 0 0.85rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cert {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--border);
  }

  .cert-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease);
  }

  .cert-link:hover { color: var(--accent); }
  .cert-name { text-wrap: pretty; }

  .cert-id {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--text-faint);
    white-space: nowrap;
    flex: none;
  }

  @media (max-width: 520px) {
    .cert { flex-direction: column; gap: 0.15rem; }
  }
</style>
