---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Icon from '../../components/Icon.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();

/** Tag counts, so the index shows what the writing is actually about. */
const tagCounts = posts
  .flatMap((p) => p.data.tags)
  .reduce<Record<string, number>>((acc, t) => ({ ...acc, [t]: (acc[t] ?? 0) + 1 }), {});
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 10);
---

<BaseLayout
  title="Engineering notes"
  description="Notes on OAuth 2.0 and OpenID Connect, JWT verification, device platforms, media playback, production debugging and AI engineering — written by Asvanth C."
>
  <section class="head">
    <div class="grid-bg"></div>
    <div class="wrap head-inner">
      <p class="eyebrow">Engineering notes</p>
      <h1 class="head-title">Things I have had to understand properly.</h1>
      <p class="head-lede">
        I write these mostly after debugging something and discovering my mental model was
        wrong. They are the explanations I wish I had found first — practical rather than
        academic, and honest about the parts I originally misunderstood.
      </p>

      <div class="head-meta">
        <span>{posts.length} notes</span>
        <span class="sep" aria-hidden="true">·</span>
        <a class="rss" href="/rss.xml"><Icon name="rss" size={13} /> RSS</a>
      </div>

      {
        topTags.length > 0 && (
          <ul class="tag-cloud">
            {topTags.map(([tag, count]) => (
              <li class="tag">
                {tag} <span class="tag-count">{count}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <div class="wrap list-wrap">
    {
      posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <p class="empty">No notes published yet.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .head {
    position: relative;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .head-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
  }

  .head-title {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
    max-width: 20ch;
  }

  .head-lede {
    margin-top: 1.1rem;
    color: var(--text-muted);
    font-size: var(--step-1);
    max-width: 60ch;
    text-wrap: pretty;
  }

  .head-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .sep { opacity: 0.5; }

  .rss {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color var(--dur) var(--ease);
  }

  .rss:hover { color: var(--accent); }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin-top: 1.6rem;
  }

  .tag-count {
    color: var(--text-faint);
    opacity: 0.8;
  }

  .list-wrap {
    padding-block: clamp(2rem, 5vw, 3rem) clamp(3.5rem, 8vw, 6rem);
  }

  .empty {
    color: var(--text-muted);
    padding-block: 3rem;
  }
</style>
